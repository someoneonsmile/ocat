# Maintainer: someoneonsmile <someoneonsmile@gmail.com>
pkgname=ocat-nightly-bin
provides=('ocat')
conflicts=('ocat' 'ocat-bin')
pkgver=20260804
pkgrel=1
pkgdesc="View opencode session exports in a pager — nightly build"
arch=('x86_64' 'aarch64')
url="https://github.com/someoneonsmile/ocat"
license=('MIT')

_source_base="${url}/releases/download/nightly"

# 同 aur/PKGBUILD：nightly 资产同样是滚动覆盖且文件名不含版本号，
# 本地文件名带上 pkgver（含日期+提交数+sha）可避免复用旧缓存。
source_x86_64=("ocat-${pkgver}-x86_64-linux-gnu.tar.gz::${_source_base}/ocat-x86_64-linux-gnu.tar.gz")
source_aarch64=("ocat-${pkgver}-aarch64-linux-gnu.tar.gz::${_source_base}/ocat-aarch64-linux-gnu.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    cd "$srcdir"
    tar xzf "ocat-${pkgver}-${CARCH}-linux-gnu.tar.gz"
    install -Dm755 "ocat-${CARCH}-linux-gnu/ocat" "$pkgdir/usr/bin/ocat"
    install -Dm644 "ocat-${CARCH}-linux-gnu/complete/ocat.bash" "$pkgdir/usr/share/bash-completion/completions/ocat" 2>/dev/null || true
    install -Dm644 "ocat-${CARCH}-linux-gnu/complete/_ocat" "$pkgdir/usr/share/zsh/site-functions/_ocat" 2>/dev/null || true
    install -Dm644 "ocat-${CARCH}-linux-gnu/complete/ocat.fish" "$pkgdir/usr/share/fish/vendor_completions.d/ocat.fish" 2>/dev/null || true
    install -Dm644 "ocat-${CARCH}-linux-gnu/man/ocat.1" "$pkgdir/usr/share/man/man1/ocat.1" 2>/dev/null || true
}
